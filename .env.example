# PostgreSQL (desarrollo local via Docker Compose)
# Valores de ejemplo seguros para desarrollo. No usar secretos reales.
POSTGRES_DB=plantilla_portales
POSTGRES_USER=plantilla_user
POSTGRES_PASSWORD=change_me_local
# Puerto del host para PostgreSQL. 5432 es el puerto por defecto.
# Si el equipo ya tiene PostgreSQL u otro servicio ocupando el 5432, cambia
# unicamente el puerto del host en tu .env local (por ejemplo a 5433) y
# ajusta tambien DATABASE_URL. El puerto interno del contenedor sigue siendo 5432.
POSTGRES_PORT=5432

# URL de conexion para el backend (apps/api), compatible con Prisma mas adelante.
# Apunta a localhost porque Prisma correra en el host, no dentro de Docker.
# Debe construirse con los mismos valores de arriba.
DATABASE_URL=postgresql://plantilla_user:change_me_local@localhost:5432/plantilla_portales

# Origenes permitidos para CORS (lista separada por comas). Lo usa el backend
# para permitir peticiones del frontend. Si no se define, el backend NO abre
# CORS (no usa "*"). En desarrollo el frontend corre en http://localhost:3000.
CORS_ORIGINS=http://localhost:3000

# Modo de resolucion de identidad. Con "dev-header" el backend resuelve el
# usuario actual desde la cabecera X-Actor-Id y expone GET /dev/actors (capa
# SOLO desarrollo). Con "jwt" usa autenticacion real: POST /auth/login emite un
# JWT y las peticiones protegidas se autentican con "Authorization: Bearer".
# Con cualquier otro valor /dev/actors responde 404. No es un secreto; es
# configuracion por ambiente.
AUTH_MODE=dev-header

# Secreto para firmar/verificar los JWT. OBLIGATORIO solo cuando AUTH_MODE=jwt
# (si falta en ese modo, la app falla al arrancar). NUNCA versiones un secreto
# real: deja el placeholder vacio y define el valor en tu .env local/produccion.
JWT_SECRET=

# Vigencia del token emitido por /auth/login (formato de @nestjs/jwt, p. ej.
# "8h", "30m", "7d"). Por defecto 8h si no se define.
JWT_EXPIRES_IN=8h

# --- Correo (SMTP) ---
# Configuracion del servidor SMTP para notificaciones (reestablecimiento de
# contrasena, invitaciones). Office365 usa smtp.office365.com:587 con STARTTLS
# (por eso SMTP_SECURE=false; secure=true solo para el puerto 465/SSL directo).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# false => STARTTLS (Office365 587). true => conexion SSL directa (p. ej. 465).
SMTP_SECURE=false
# Usuario y contrasena de la cuenta SMTP. SON SECRETOS/por-ambiente: deja el
# placeholder vacio en el repo y define el valor real en tu .env local.
SMTP_USER=
SMTP_PASSWORD=
# Direccion remitente de los correos. Por-ambiente: dejar vacio en el repo.
MAIL_FROM=
# Nombre visible opcional del remitente. No es secreto.
MAIL_FROM_NAME=Notificaciones
# URL base del frontend para construir enlaces (reset, invitacion).
APP_WEB_URL=http://localhost:3000

# Vigencia del enlace de reestablecimiento de contrasena. Formato simple
# <numero><unidad> (s/m/h/d) o milisegundos; por defecto 1h. No es secreto.
PASSWORD_RESET_TTL=1h
# Vigencia del enlace de invitacion/activacion de cuenta. Por defecto 72h.
USER_INVITATION_TTL=72h
# Longitud minima de contrasena al reestablecer/activar. Por defecto 8.
PASSWORD_MIN_LENGTH=8

# --- Actividades recurrentes (FEAT-001) ---
# Motor in-process (@nestjs/schedule) que genera ocurrencias futuras y marca
# vencidas. Ninguna de estas variables es un secreto; son configuracion por
# ambiente con defaults seguros. El API arranca sin definirlas.
# Zona horaria del calendario de ocurrencias (fechas de calendario sin hora).
# Por defecto America/Lima.
RECURRING_ACTIVITY_TIMEZONE=America/Lima
# Dias de anticipacion por defecto al generar ocurrencias futuras (entero > 0).
# Por defecto 14. Una definicion puede sobrescribirlo con su anticipationDays.
RECURRING_ACTIVITY_ANTICIPATION_DAYS=14
# Cron (formato @nestjs/schedule) de la generacion diaria de ocurrencias.
# Por defecto "0 1 * * *" (01:00 todos los dias).
RECURRING_ACTIVITY_GENERATION_CRON=0 1 * * *
# Cron del marcado diario de ocurrencias vencidas.
# Por defecto "0 2 * * *" (02:00 todos los dias).
RECURRING_ACTIVITY_OVERDUE_CRON=0 2 * * *
# Dias de antelacion al dia objetivo para enviar el recordatorio por correo
# (entero >= 0). Por defecto 3. El recordatorio degrada sin SMTP (no bloquea).
RECURRING_ACTIVITY_REMINDER_DAYS=3
# Cron del envio diario de recordatorios por correo.
# Por defecto "0 3 * * *" (03:00 todos los dias).
RECURRING_ACTIVITY_REMINDER_CRON=0 3 * * *
# Interruptor del motor: "false" desactiva los crons (util en entornos donde no
# debe correr trabajo en segundo plano). Cualquier otro valor (o ausente) lo
# deja activo. Por defecto true.
RECURRING_ACTIVITY_SCHEDULER_ENABLED=true

# --- Observabilidad / Logging ---
# Nivel de log del backend (pino). Valores validos:
# fatal | error | warn | info | debug | trace | silent. Por defecto "info" si
# no se define. No es un secreto; es configuracion por ambiente.
LOG_LEVEL=info
# Formato de salida del log. "true" => salida legible (pino-pretty), util en
# desarrollo. Cualquier otro valor (o ausente) => JSON estructurado (produccion).
# Por defecto desactivado. No es un secreto.
LOG_PRETTY=true

# --- Cifrado de secretos de configuracion ---
# Clave para cifrar/descifrar secretos de configuracion guardados en BD (hoy: el
# password SMTP editable desde administracion). 32 bytes codificados en base64.
# Genera uno con: openssl rand -base64 32
# Es un SECRETO por-ambiente: deja el placeholder vacio en el repo y define el
# valor real en tu .env local/produccion. Obligatoria SOLO al leer/escribir el
# password SMTP; el API arranca sin ella. Si la pierdes/rotas, el password
# cifrado guardado deja de poder descifrarse y hay que reconfigurarlo.
SETTINGS_ENCRYPTION_KEY=

# --- Almacenamiento de archivos (evidencias de tareas) en el bucket maestro S3 ---
# Las credenciales AWS las toma la cadena por defecto del SDK (rol/perfil/AWS_*).
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-2
# Vigencia (segundos) de las URLs de descarga y tamano maximo por archivo (bytes).
STORAGE_PRESIGN_TTL_SECONDS=300
EVIDENCE_MAX_BYTES=8388608
# Dias de anticipacion para la alerta 'proximo a vencer' del portafolio.
PORTFOLIO_DUE_SOON_DAYS=7
