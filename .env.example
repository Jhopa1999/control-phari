# PostgreSQL (desarrollo local via Docker Compose)
# Valores de ejemplo seguros para desarrollo. No usar secretos reales.
POSTGRES_DB=plantilla_portales
POSTGRES_USER=plantilla_user
POSTGRES_PASSWORD=change_me_local
# Puerto del host para PostgreSQL. 5432 es el puerto por defecto.
# Si el equipo ya tiene PostgreSQL u otro servicio ocupando el 5432, cambia
# unicamente el puerto del host en tu .env local (por ejemplo a 5433) y
# ajusta tambien DATABASE_URL. El puerto interno del contenedor sigue siendo 5432.
POSTGRES_PORT=5432

# URL de conexion para el backend (apps/api), compatible con Prisma mas adelante.
# Apunta a localhost porque Prisma correra en el host, no dentro de Docker.
# Debe construirse con los mismos valores de arriba.
DATABASE_URL=postgresql://plantilla_user:change_me_local@localhost:5432/plantilla_portales

# Origenes permitidos para CORS (lista separada por comas). Lo usa el backend
# para permitir peticiones del frontend. Si no se define, el backend NO abre
# CORS (no usa "*"). En desarrollo el frontend corre en http://localhost:3000.
CORS_ORIGINS=http://localhost:3000
