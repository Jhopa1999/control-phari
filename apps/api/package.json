{
  "name": "@plantilla-portales/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend NestJS de la plantilla de portales.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "openapi:generate": "tsx src/generate-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.4",
    "dotenv": "^18.0.6",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "source-map-support": "0.5.21",
    "ts-jest": "^29.4.14",
    "ts-node": "10.9.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
