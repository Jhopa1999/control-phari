// Prisma schema (Prisma ORM v7).
// La URL de conexion NO se define aqui: se configura en prisma.config.ts
// mediante datasource.url = env("DATABASE_URL"), que lee el .env de la raiz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Elemento generico de una maestra/catalogo reutilizable por los portales.
/// No representa ninguna maestra de negocio concreta: `catalog` identifica a
/// que maestra pertenece cada opcion (p. ej. PRIORITY, STATUS, PROJECT_TYPE).
model CatalogItem {
  id        String   @id @default(uuid()) @db.Uuid
  catalog   String
  code      String
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Un codigo es unico dentro de un mismo catalogo, pero puede repetirse en
  // otros catalogos.
  @@unique([catalog, code], name: "catalog_code_unique")
  // Indices para los filtros/orden habituales (catalog, active, sortOrder).
  @@index([catalog])
  @@index([active])
  @@index([sortOrder])
  @@map("catalog_items")
}

/// Proceso de gestion del area (BI, Integraciones, IA) y la coordinacion
/// multiproceso FMAA. `code` es estable y se almacena en MAYUSCULAS.
model Process {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  name      String
  framework String?
  kind      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  grants      Grant[]
  auditEvents AuditEvent[]

  // Fase 2 (flujo de demanda): proceso principal y participaciones.
  requests              Request[]            @relation("RequestMainProcess")
  requestParticipations RequestParticipant[]

  // Fase 3 (plan): tareas que referencian este proceso como contexto (informativo).
  tasks Task[]

  // Fase 4 (capacidad): asignaciones de horas en este proceso.
  assignments Assignment[]

  // Fase 5 (trabajo y coordinacion): registros de trabajo de este proceso.
  dailyLogs     DailyLog[]
  weeklyReports WeeklyReport[]
  issues        Issue[]
  meetings      Meeting[]
  commitments   Commitment[]

  // Fase 6 (activos): activos anclados a este proceso.
  assets Asset[]

  @@unique([code], name: "process_code_unique")
  @@index([active])
  @@index([sortOrder])
  @@map("processes")
}

/// Identidad funcional de una persona del area. NO es credencial: no hay
/// password, token ni sesion (la autenticacion real es una capa separada).
model User {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  name       String
  active     Boolean  @default(true)
  // Hash bcrypt de la credencial, usado solo por la autenticacion real (JWT).
  // Nullable: dev-header no lo usa y las filas existentes no lo tienen; no es
  // credencial en modo dev. Nunca se expone en DTOs ni respuestas.
  passwordHash String? @map("password_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  grants      Grant[]
  auditEvents AuditEvent[]

  // Fase 2 (flujo de demanda): actor que registro cada decision y, por
  // separado, triages donde la persona es responsable principal (segunda FK a
  // User, por eso ambas relaciones Triage->User llevan `name`).
  triages                  Triage[]             @relation("TriageDecidedBy")
  triagesAsMainResponsible Triage[]             @relation("TriageMainResponsible")
  priorityEvaluations PriorityEvaluation[]
  approvals           Approval[]

  // Fase 3 (plan): planes enviados/autorizados y tareas de las que es
  // responsable o que acepto. Cada relacion usa un `name` distinto porque hay
  // mas de una FK User por modelo (Prisma exige nombrarlas).
  plansSubmitted   Plan[] @relation("PlanSubmittedBy")
  plansAuthorized  Plan[] @relation("PlanAuthorizedBy")
  tasksResponsible Task[] @relation("TaskResponsible")
  tasksAccepted    Task[] @relation("TaskAcceptedBy")

  // Fase 4 (capacidad): disponibilidad mensual y asignaciones de la persona.
  monthlyAvailabilities MonthlyAvailability[]
  assignments           Assignment[]          @relation("AssignmentUser")

  // Fase 5 (trabajo y coordinacion): registros donde la persona es autor,
  // responsable, asignada o participante. Cada relacion usa `name` propio
  // porque hay mas de una FK User por modelo (Prisma lo exige).
  dailyLogs              DailyLog[]           @relation("DailyLogAuthor")
  weeklyReports          WeeklyReport[]       @relation("WeeklyReportAuthor")
  issuesReported         Issue[]              @relation("IssueReportedBy")
  issuesResolved         Issue[]              @relation("IssueResolver")
  meetingsResponsible    Meeting[]            @relation("MeetingResponsible")
  meetingParticipations  MeetingParticipant[]
  commitmentsResponsible Commitment[]         @relation("CommitmentResponsible")
  commitmentsAssigned    Commitment[]         @relation("CommitmentAssigned")

  // Fase 6 (activos y documentos): activos de los que es dueno/responsable y
  // versiones de documento de las que es autor.
  assetsOwned              Asset[]           @relation("AssetOwner")
  documentVersionsAuthored DocumentVersion[] @relation("DocumentVersionAuthor")

  // Fase 7 (gobierno de la demanda): decisiones de gate, faltantes a cargo,
  // validaciones ejecutadas/resueltas y bloqueos de Request. Cada relacion usa
  // `name` propio porque hay mas de una FK User por modelo (Prisma lo exige).
  gateChecksDecided            GateCheck[]        @relation("GateCheckDecider")
  gatePendingOwned             GatePendingItem[]  @relation("GatePendingOwner")
  validationsExecuted          ValidationRecord[] @relation("ValidationExecutor")
  validationsBlockingResolved  ValidationRecord[] @relation("ValidationBlockingResolver")
  requestsBlocked              Request[]          @relation("RequestBlockedBy")
  requestsBlockResolved        Request[]          @relation("RequestBlockedResolvedBy")

  // Mail-fase1 (FEAT-002): tokens de un solo uso para reset de contrasena e
  // invitacion/activacion. Se borran en cascada si se elimina el usuario.
  authTokens AuthToken[]

  @@unique([identifier], name: "user_identifier_unique")
  @@index([active])
  @@map("users")
}

/// Token de un solo uso para flujos de credencial por correo (reset de
/// contrasena e invitacion/activacion). El token en claro (crypto.randomBytes
/// >=32 bytes, alta entropia) viaja SOLO en el correo; en BD se guarda unicamente
/// su SHA-256 (`tokenHash`): al ser aleatorio y de alta entropia, un hash rapido
/// como sha256 es suficiente para evitar lookups por el valor en claro y no se
/// necesita bcrypt (bcrypt protege contrasenas elegidas por personas, de baja
/// entropia y vulnerables a fuerza bruta, lo que aqui no aplica). `purpose`
/// distingue el flujo (PASSWORD_RESET / USER_INVITATION); `usedAt` marca el
/// consumo (un solo uso) y `expiresAt` la caducidad.
model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("auth_tokens")
}

/// Catalogo cerrado de 3 perfiles. El `code` gobierna la logica de
/// autorizacion (enum logico: JEFE_AREA, LIDER_PROCESO, INTEGRANTE).
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  grants Grant[]

  @@unique([code], name: "role_code_unique")
  @@map("roles")
}

/// Asignacion de un usuario a un rol dentro de un proceso. Es el corazon del
/// alcance. Revocar = active=false (soft-delete, por trazabilidad).
model Grant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  processId String   @map("process_id") @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  process Process @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, processId], name: "grant_user_role_process_unique")
  @@index([userId])
  @@index([processId])
  @@index([roleId])
  @@index([active])
  @@map("grants")
}

/// Registro append-only de cada mutacion. Sin updatedAt (es inmutable).
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  objectType     String   @map("object_type")
  objectId       String   @map("object_id")
  scopeProcessId String?  @map("scope_process_id") @db.Uuid
  before         Json?
  after          Json?
  createdAt      DateTime @default(now()) @map("created_at")

  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  scopeProcess Process? @relation(fields: [scopeProcessId], references: [id], onDelete: Restrict)

  @@index([objectType, objectId])
  @@index([actorUserId])
  @@index([scopeProcessId])
  @@index([createdAt])
  @@map("audit_events")
}

// ============================================================================
// Fase 2 · Flujo de demanda (Solicitud -> Triage -> Priorizacion -> Aprobacion)
// Diseno aprobado en .agents/tasks/fase2-demanda/design.md §1.2.
// ============================================================================

/// Solicitud (ficha de la demanda). Nucleo del flujo FLOW-001 (BR-001/017/022).
/// `operationalState` es un enum logico derivado/read-only: solo lo escribe el
/// helper de transicion de RequestStateService, nunca un update/DTO libre.
model Request {
  id                    String    @id @default(uuid()) @db.Uuid
  title                 String
  registeredAt          DateTime  @default(now()) @map("registered_at")
  requesterArea         String?   @map("requester_area")
  requesterName         String?   @map("requester_name")
  functionalOwner       String?   @map("functional_owner")
  targetDate            DateTime? @map("target_date")
  referenceUrl          String?   @map("reference_url")
  expectedResult        String?   @map("expected_result")
  mainProcessId         String    @map("main_process_id") @db.Uuid
  operationalState      String    @default("REGISTRADA") @map("operational_state")
  initialCommitmentDate DateTime? @map("initial_commitment_date")
  changeJustification   String?   @map("change_justification")
  // Fase 7 (gobierno · design §2.5, aditivo): ruta proporcional del marco §6
  // (catalogo GOVERNANCE_ROUTE, nullable hasta que el lider la elija) y el flag
  // transversal de bloqueo (D-B7/MEDIUM-1). El bloqueo convive con
  // `operationalState` (no lo reemplaza) y aplica en cualquier etapa:
  // "Request bloqueada" = blockedAt != null AND blockedResolvedAt == null.
  governanceRoute        String?   @map("governance_route")
  blockedReason          String?   @map("blocked_reason")
  blockedAt              DateTime? @map("blocked_at")
  blockedByUserId        String?   @map("blocked_by_user_id") @db.Uuid
  blockedResolvedAt      DateTime? @map("blocked_resolved_at")
  blockedResolvedByUserId String?  @map("blocked_resolved_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  mainProcess         Process              @relation("RequestMainProcess", fields: [mainProcessId], references: [id], onDelete: Restrict)
  participants        RequestParticipant[]
  triages             Triage[]
  priorityEvaluations PriorityEvaluation[]
  approvals           Approval[]

  // Fase 3 (plan): a lo sumo un plan por Request (1:1 efectivo, D1).
  plan Plan?

  // Fase 4 (capacidad): asignaciones opcionalmente ligadas a esta solicitud.
  assignments Assignment[]

  // Fase 5 (trabajo y coordinacion): referencias opcionales a esta solicitud
  // ("proyecto"=Request, §1.2 D12). Cuando un modelo tiene mas de una FK a
  // Request se usa `name` propio por relacion.
  dailyLogActivities   DailyLogActivity[]
  issues               Issue[]            @relation("IssueRelatedRequest")
  meetingsRelated      Meeting[]          @relation("MeetingRelatedRequest")
  meetingsAsProject    Meeting[]          @relation("MeetingRelatedProjectRequest")
  commitmentsRelated   Commitment[]       @relation("CommitmentRelatedRequest")
  commitmentsAsProject Commitment[]       @relation("CommitmentRelatedProjectRequest")

  // Fase 6 (activos): activos cuya solicitud de origen es esta Request.
  assets Asset[]

  // Fase 7 (gobierno): gates de control, validaciones y FK del flag de bloqueo.
  gateChecks        GateCheck[]
  validationRecords ValidationRecord[]
  blockedBy         User?              @relation("RequestBlockedBy", fields: [blockedByUserId], references: [id], onDelete: Restrict)
  blockedResolvedBy User?              @relation("RequestBlockedResolvedBy", fields: [blockedResolvedByUserId], references: [id], onDelete: Restrict)

  @@index([mainProcessId])
  @@index([operationalState])
  @@index([registeredAt])
  @@index([governanceRoute])
  @@index([blockedAt])
  @@map("requests")
}

/// Tabla puente N:M Request <-> Process (procesos participantes). El proceso
/// principal siempre se materializa aqui como invariante de datos (BR-001, D2).
model RequestParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  processId String   @map("process_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  process Process @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@unique([requestId, processId], name: "request_participant_unique")
  @@index([processId])
  @@map("request_participants")
}

/// Triage: clasificacion y decision de ruta (BR-004, SCR-04). Tabla 1:N por
/// extensibilidad futura; en Fase 2 el gate solo admite un Triage por Request.
model Triage {
  id                   String   @id @default(uuid()) @db.Uuid
  requestId            String   @map("request_id") @db.Uuid
  routeCode            String?  @map("route_code")
  demandTypeCode       String?  @map("demand_type_code")
  criticalityCode      String?  @map("criticality_code")
  sizeCode             String?  @map("size_code")
  dataAvailabilityCode String?  @map("data_availability_code")
  totalEffortHours     Int?     @map("total_effort_hours")
  mainResponsibleUserId String? @map("main_responsible_user_id") @db.Uuid
  decision             String
  decidedAt            DateTime @default(now()) @map("decided_at")
  decidedByUserId      String   @map("decided_by_user_id") @db.Uuid
  dependencies         String?
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  request         Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decidedBy       User    @relation("TriageDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  mainResponsible User?   @relation("TriageMainResponsible", fields: [mainResponsibleUserId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([decidedByUserId])
  @@index([mainResponsibleUserId])
  @@map("triages")
}

/// Evaluacion ponderada de 8 criterios (BR-005, SCR-05). 1:N historico; la
/// vigente es la ultima por `evaluatedAt`. `score` lo calcula el backend.
model PriorityEvaluation {
  id                String   @id @default(uuid()) @db.Uuid
  requestId         String   @map("request_id") @db.Uuid
  impact            Int
  alignment         Int
  riskControl       Int      @map("risk_control")
  urgency           Int
  scope             Int
  dataAvailability  Int      @map("data_availability")
  feasibility       Int
  reuse             Int
  score             Int
  justification     String?
  evaluatedAt       DateTime @default(now()) @map("evaluated_at")
  evaluatedByUserId String   @map("evaluated_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  request     Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  evaluatedBy User    @relation(fields: [evaluatedByUserId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([evaluatedByUserId])
  @@map("priority_evaluations")
}

/// Decision de autorizacion del compromiso, separada del guardado de la
/// evaluacion (BR-006, SCR-20, D6). Append-only (sin updatedAt).
model Approval {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String   @map("request_id") @db.Uuid
  decision        String
  reason          String?
  previousState   String   @map("previous_state")
  resultingState  String   @map("resulting_state")
  decidedAt       DateTime @default(now()) @map("decided_at")
  decidedByUserId String   @map("decided_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decidedBy User    @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([decidedByUserId])
  @@index([decidedAt])
  @@map("approvals")
}

// ============================================================================
// Fase 3 · Plan y ejecucion (Plan -> Fases -> Tareas -> Dependencias)
// Diseno aprobado en .agents/tasks/fase3-plan/design.md §1.2.
// ============================================================================

/// Plan de trabajo de una Request comprometida (design §1.2, D1). 1:1 efectivo
/// con Request (FK `request_id` unica). `status` es un enum logico PlanStatus
/// read-only: solo lo escribe el helper de PlanStateService, nunca un DTO libre.
/// Nota Prisma 7 (§1.1): el plan se resuelve por `request_id` con `findFirst`,
/// no `findUnique`; el `@@unique` solo garantiza el 1:1 a nivel de BD.
model Plan {
  id                 String    @id @default(uuid()) @db.Uuid
  requestId          String    @map("request_id") @db.Uuid
  periodStart        DateTime? @map("period_start")
  periodEnd          DateTime? @map("period_end")
  commitmentDate     DateTime? @map("commitment_date")
  risks              String?
  mitigations        String?
  status             String    @default("BORRADOR")
  submittedAt        DateTime? @map("submitted_at")
  submittedByUserId  String?   @map("submitted_by_user_id") @db.Uuid
  authorizedAt       DateTime? @map("authorized_at")
  authorizedByUserId String?   @map("authorized_by_user_id") @db.Uuid
  returnReason       String?   @map("return_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  request      Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  phases       PlanPhase[]
  submittedBy  User?       @relation("PlanSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  authorizedBy User?       @relation("PlanAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: Restrict)

  @@unique([requestId], name: "plan_request_unique")
  @@index([status])
  @@map("plans")
}

/// Fase del plan (design §1.2, AC-009). Ordenada por `order` 0-based dentro del
/// plan. La "fase inicial" es la de `order` minimo (propiedad derivada, sin flag).
model PlanPhase {
  id          String    @id @default(uuid()) @db.Uuid
  planId      String    @map("plan_id") @db.Uuid
  name        String
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  deliverable String?
  order       Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  plan  Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([planId, order], name: "plan_phase_order_unique")
  @@index([planId])
  @@map("plan_phases")
}

/// Tarea del plan (design §1.2, BR-009/010/013; AC-010/011/033). `status` y
/// `accepted` son enum logico/derivados: solo los escriben los helpers del
/// modulo plan. El gate de dependientes exige TERMINADA Y accepted.
model Task {
  id                     String    @id @default(uuid()) @db.Uuid
  phaseId                String    @map("phase_id") @db.Uuid
  processId              String?   @map("process_id") @db.Uuid
  title                  String
  responsibleUserId      String?   @map("responsible_user_id") @db.Uuid
  startDate              DateTime? @map("start_date")
  endDate                DateTime? @map("end_date")
  estimateHours          Int?      @map("estimate_hours")
  isMilestone            Boolean   @default(false) @map("is_milestone")
  description            String?
  acceptanceCriteria     String?   @map("acceptance_criteria")
  status                 String    @default("POR_HACER")
  progress               Int       @default(0)
  frameworkPhaseRequired String?   @map("framework_phase_required")
  accepted               Boolean   @default(false)
  acceptedAt             DateTime? @map("accepted_at")
  acceptedByUserId       String?   @map("accepted_by_user_id") @db.Uuid
  evidenceUrl            String?   @map("evidence_url")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  phase       PlanPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  process     Process?  @relation(fields: [processId], references: [id], onDelete: Restrict)
  responsible User?     @relation("TaskResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  acceptedBy  User?     @relation("TaskAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  dependenciesAsDependent   TaskDependency[] @relation("DependencyDependent")
  dependenciesAsPredecessor TaskDependency[] @relation("DependencyPredecessor")

  // Fase 5 (trabajo y coordinacion): referencias opcionales a esta tarea.
  dailyLogActivities DailyLogActivity[]
  issues             Issue[]            @relation("IssueRelatedTask")

  @@index([phaseId])
  @@index([responsibleUserId])
  @@index([status])
  @@map("tasks")
}

/// Dependencia dirigida entre dos tareas del mismo plan (design §1.2, BR-009;
/// AC-010/033). Append-only (sin updatedAt). El `@@unique` compuesto es la clave
/// de idempotencia/duplicado; se consulta con `findUnique` (compuesto, §1.1).
model TaskDependency {
  id                String   @id @default(uuid()) @db.Uuid
  dependentTaskId   String   @map("dependent_task_id") @db.Uuid
  predecessorTaskId String   @map("predecessor_task_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  dependent   Task @relation("DependencyDependent", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  predecessor Task @relation("DependencyPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, predecessorTaskId], name: "task_dependency_unique")
  @@index([predecessorTaskId])
  @@map("task_dependencies")
}

// ============================================================================
// Fase 4 · Capacidad (Disponibilidad mensual + Asignaciones de horas)
// Diseno aprobado en .agents/tasks/fase4-capacidad/design.md §1.2.
// ============================================================================

/// Disponibilidad de horas de una persona en un mes (BR-012; FLOW-007; SCR-17).
/// Una fila por persona/mes (`@@unique` compuesto). NO se captura por proceso:
/// la disponibilidad es un atributo de la persona en el periodo (D1). `month`
/// se persiste como la fecha del PRIMER dia del mes en UTC (`@db.Date`, D2); el
/// contrato externo usa el string `YYYY-MM` (el service convierte en los DTOs).
model MonthlyAvailability {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  month          DateTime @db.Date
  availableHours Int      @map("available_hours")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Compuesto -> usable como `where` de findUnique/upsert (§1.1, caso favorable).
  @@unique([userId, month], name: "monthly_availability_user_month_unique")
  @@index([month])
  @@map("monthly_availabilities")
}

/// Horas comprometidas de una persona en un mes, en un proceso (requerido) y
/// opcionalmente ligadas a una solicitud (BR-012; SCR-17). Las asignaciones se
/// AGREGAN por periodo/proceso: N filas por persona/mes, SIN `@@unique` estricto
/// (D3). `month` usa el mismo formato (primer dia del mes, UTC) que la
/// disponibilidad. `description` es texto libre informativo (FINDING 7).
model Assignment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  month          DateTime @db.Date
  processId      String   @map("process_id") @db.Uuid
  requestId      String?  @map("request_id") @db.Uuid
  committedHours Int      @map("committed_hours")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user    User     @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  process Process  @relation(fields: [processId], references: [id], onDelete: Restrict)
  request Request? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([userId, month])
  @@index([processId])
  @@index([requestId])
  @@map("assignments")
}

// ============================================================================
// Fase 5 · Trabajo y coordinacion (Bitacora + Novedades + Reuniones + Compromisos)
// Diseno aprobado en .agents/tasks/fase5-trabajo/design.md §1.2.
// ============================================================================

/// Registro diario (cabecera por proceso + fecha + autor; SCR-10). Agrupa N
/// actividades (1:N, §11 D1). `status` es enum logico DailyLogStatus read-only:
/// solo lo escribe el helper de estado del modulo coordination. `date` se
/// persiste como fecha UTC (`@db.Date`, §11 D8); contrato externo `YYYY-MM-DD`.
model DailyLog {
  id           String    @id @default(uuid()) @db.Uuid
  authorUserId String    @map("author_user_id") @db.Uuid
  processId    String    @map("process_id") @db.Uuid
  date         DateTime  @db.Date
  status       String    @default("BORRADOR")
  submittedAt  DateTime? @map("submitted_at")
  dayNotes     String?   @map("day_notes")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  author     User               @relation("DailyLogAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  process    Process            @relation(fields: [processId], references: [id], onDelete: Restrict)
  activities DailyLogActivity[]

  // Compuesto -> usable como `where` de findUnique/upsert (§1.1, caso favorable).
  @@unique([authorUserId, processId, date], name: "daily_log_author_process_date_unique")
  @@index([processId])
  @@index([date])
  @@index([status])
  @@map("daily_logs")
}

/// Actividad de un registro diario (SCR-10 · BR-014). Lleva clasificacion
/// (maestra ACTIVITY_CLASS) y referencias opcionales condicionadas a ella.
/// `hours` es dedicacion (BR-013); nunca toca Task.estimateHours/progress.
model DailyLogActivity {
  id                 String    @id @default(uuid()) @db.Uuid
  dailyLogId         String    @map("daily_log_id") @db.Uuid
  classificationCode String    @map("classification_code")
  projectRequestId   String?   @map("project_request_id") @db.Uuid
  taskId             String?   @map("task_id") @db.Uuid
  assetRef           String?   @map("asset_ref")
  requesterRef       String?   @map("requester_ref")
  justification      String?
  description        String?
  result             String?
  activityStatus     String?   @map("activity_status")
  hours              Int       @default(0)
  evidenceUrl        String?   @map("evidence_url")
  relatedIssueId     String?   @map("related_issue_id") @db.Uuid
  nextStep           String?   @map("next_step")
  nextStepDate       DateTime? @map("next_step_date") @db.Date
  // Fase 6 (gancho): FK opcional NUEVA al activo, convive con assetRef (texto,
  // Fase 5). NO se cablea desde los flujos de Fase 5 ni toca su validacion.
  assetId            String?   @map("asset_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  dailyLog       DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  projectRequest Request? @relation(fields: [projectRequestId], references: [id], onDelete: Restrict)
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  relatedIssue   Issue?   @relation(fields: [relatedIssueId], references: [id], onDelete: Restrict)
  asset          Asset?   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([dailyLogId])
  @@index([classificationCode])
  @@index([taskId])
  @@index([projectRequestId])
  @@index([relatedIssueId])
  @@index([assetId])
  @@map("daily_log_activities")
}

/// Registro semanal (SCR-11 · `08` Semanal). Ancla al lunes de la semana.
/// Consolida por lectura (no copia) los diarios ENVIADO/REVISADO del proceso.
/// Las secciones son texto: no mutan prioridad ni crean compromisos (AC-018).
model WeeklyReport {
  id              String    @id @default(uuid()) @db.Uuid
  authorUserId    String    @map("author_user_id") @db.Uuid
  processId       String    @map("process_id") @db.Uuid
  weekStart       DateTime  @map("week_start") @db.Date
  status          String    @default("BORRADOR")
  submittedAt     DateTime? @map("submitted_at")
  results         String?
  proposals       String?
  blockers        String?
  commitmentsText String?   @map("commitments_text")
  decisions       String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  author  User    @relation("WeeklyReportAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  process Process @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@unique([authorUserId, processId, weekStart], name: "weekly_report_author_process_week_unique")
  @@index([processId])
  @@index([weekStart])
  @@map("weekly_reports")
}

/// Novedad (SCR-12 · `08` Novedad). Un registro por incidente que se edita
/// hasta resolver (AC-019). `typeCode` maestra ISSUE_TYPE (default BLOQUEO);
/// `state` maestra RECORD_STATE con maquina minima reversible (default EN_CURSO).
model Issue {
  id               String    @id @default(uuid()) @db.Uuid
  processId        String    @map("process_id") @db.Uuid
  reportedByUserId String    @map("reported_by_user_id") @db.Uuid
  date             DateTime  @db.Date
  typeCode         String    @default("BLOQUEO") @map("type_code")
  relatedRequestId String?   @map("related_request_id") @db.Uuid
  relatedTaskId    String?   @map("related_task_id") @db.Uuid
  relatedAssetRef  String?   @map("related_asset_ref")
  title            String
  detail           String?
  impact           String?
  resolverUserId   String?   @map("resolver_user_id") @db.Uuid
  targetDate       DateTime? @map("target_date") @db.Date
  resolution       String?
  state            String    @default("EN_CURSO")
  // Fase 6 (gancho): FK opcional NUEVA al activo, convive con relatedAssetRef
  // (texto, Fase 5). NO se cablea desde los flujos de Fase 5.
  assetId          String?   @map("asset_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  process            Process            @relation(fields: [processId], references: [id], onDelete: Restrict)
  reportedBy         User               @relation("IssueReportedBy", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  resolver           User?              @relation("IssueResolver", fields: [resolverUserId], references: [id], onDelete: Restrict)
  relatedRequest     Request?           @relation("IssueRelatedRequest", fields: [relatedRequestId], references: [id], onDelete: Restrict)
  relatedTask        Task?              @relation("IssueRelatedTask", fields: [relatedTaskId], references: [id], onDelete: Restrict)
  relatedAsset       Asset?             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  dailyLogActivities DailyLogActivity[]

  @@index([processId])
  @@index([reportedByUserId])
  @@index([state])
  @@index([typeCode])
  @@index([assetId])
  @@map("issues")
}

/// Reunion (SCR-13 · `08` Reunion). Estado inicial BORRADOR; participantes N:M
/// con User via MeetingParticipant. `meetingTime` es texto HH:mm (no fija zona).
model Meeting {
  id                      String   @id @default(uuid()) @db.Uuid
  processId               String   @map("process_id") @db.Uuid
  title                   String
  state                   String   @default("BORRADOR")
  relatedRequestId        String?  @map("related_request_id") @db.Uuid
  responsibleUserId       String?  @map("responsible_user_id") @db.Uuid
  meetingDate             DateTime @map("meeting_date") @db.Date
  meetingTime             String?  @map("meeting_time")
  relatedProjectRequestId String?  @map("related_project_request_id") @db.Uuid
  agenda                  String?
  decisions               String?
  notes                   String?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  process               Process              @relation(fields: [processId], references: [id], onDelete: Restrict)
  responsible           User?                @relation("MeetingResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  relatedRequest        Request?             @relation("MeetingRelatedRequest", fields: [relatedRequestId], references: [id], onDelete: Restrict)
  relatedProjectRequest Request?             @relation("MeetingRelatedProjectRequest", fields: [relatedProjectRequestId], references: [id], onDelete: Restrict)
  participants          MeetingParticipant[]
  commitments           Commitment[]

  @@index([processId])
  @@index([state])
  @@index([meetingDate])
  @@map("meetings")
}

/// Puente N:M Meeting <-> User (participantes). Append-only (solo created_at).
model MeetingParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @map("meeting_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([meetingId, userId], name: "meeting_participant_unique")
  @@index([userId])
  @@map("meeting_participants")
}

/// Compromiso (SCR-14 · `08` Compromiso). Vencimiento requerido; reunion fuente
/// opcional (sin auto-creacion, §11 D7). `state` maestra RECORD_STATE con
/// maquina minima reversible (default EN_CURSO).
model Commitment {
  id                      String   @id @default(uuid()) @db.Uuid
  processId               String   @map("process_id") @db.Uuid
  title                   String
  state                   String   @default("EN_CURSO")
  relatedRequestId        String?  @map("related_request_id") @db.Uuid
  responsibleUserId       String?  @map("responsible_user_id") @db.Uuid
  assignedUserId          String?  @map("assigned_user_id") @db.Uuid
  dueDate                 DateTime @map("due_date") @db.Date
  relatedProjectRequestId String?  @map("related_project_request_id") @db.Uuid
  sourceMeetingId         String?  @map("source_meeting_id") @db.Uuid
  expectedResult          String?  @map("expected_result")
  result                  String?
  blockers                String?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  process               Process  @relation(fields: [processId], references: [id], onDelete: Restrict)
  responsible           User?    @relation("CommitmentResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  assigned              User?    @relation("CommitmentAssigned", fields: [assignedUserId], references: [id], onDelete: Restrict)
  relatedRequest        Request? @relation("CommitmentRelatedRequest", fields: [relatedRequestId], references: [id], onDelete: Restrict)
  relatedProjectRequest Request? @relation("CommitmentRelatedProjectRequest", fields: [relatedProjectRequestId], references: [id], onDelete: Restrict)
  sourceMeeting         Meeting? @relation(fields: [sourceMeetingId], references: [id], onDelete: Restrict)

  @@index([processId])
  @@index([state])
  @@index([assignedUserId])
  @@index([responsibleUserId])
  @@index([sourceMeetingId])
  @@index([dueDate])
  @@map("commitments")
}

// ============================================================================
// Fase 6 · Activos y documentos (Activo + Documento + Version de documento)
// Diseno aprobado en .agents/tasks/fase6-activos/design.md §1.2.
// ============================================================================

/// Activo analitico (SCR-15 · `08` Activo). Ficha de inventario anclada a un
/// proceso (FK requerida = ancla de alcance). `status` es enum logico
/// AssetStatus read-only (default BORRADOR): solo lo escribe el helper de
/// AssetStateService, nunca un DTO libre. Los atributos tipo/tecnologia/fuente/
/// frecuencia se guardan como CODIGO de maestra (String, no FK a CatalogItem),
/// validados en el service (design §1.2 D2). Sin borrado fisico: retiro =
/// cambio de estado (design §4.1 D3).
model Asset {
  id                    String   @id @default(uuid()) @db.Uuid
  processId             String   @map("process_id") @db.Uuid
  requestId             String?  @map("request_id") @db.Uuid
  ownerUserId           String?  @map("owner_user_id") @db.Uuid
  name                  String
  status                String   @default("BORRADOR")
  typeCode              String?  @map("type_code")
  technologyCode        String?  @map("technology_code")
  sourceCode            String?  @map("source_code")
  frequencyCode         String?  @map("frequency_code")
  documentationRef      String?  @map("documentation_ref")
  functionalDescription String?  @map("functional_description")
  dependencies          String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  process Process  @relation(fields: [processId], references: [id], onDelete: Restrict)
  request Request? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  owner   User?    @relation("AssetOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  documents          Document[]
  dailyLogActivities DailyLogActivity[]
  issues             Issue[]

  @@index([processId])
  @@index([requestId])
  @@index([status])
  @@index([typeCode])
  @@map("assets")
}

/// Documento (SCR-16 · `08` Documento). Metadatos de un documento Markdown;
/// `assetId` FK REQUERIDA al activo. `status` es enum logico DocStatus read-only
/// (default BORRADOR), movido SOLO por POST /documents/:id/status. El contenido
/// NO vive aqui: vive en DocumentVersion (design §1.2 D4). `currentVersionId`
/// apunta a la ultima version de contenido (ortogonal al status).
model Document {
  id               String   @id @default(uuid()) @db.Uuid
  assetId          String   @map("asset_id") @db.Uuid
  title            String
  categoryCode     String?  @map("category_code")
  status           String   @default("BORRADOR")
  currentVersionId String?  @map("current_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  asset          Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  versions       DocumentVersion[] @relation("DocumentVersions")
  currentVersion DocumentVersion?  @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)

  // Fase 7 (gobierno): registros de validacion que usan este documento como
  // evidencia (BR-016).
  validationEvidences ValidationRecord[] @relation("ValidationEvidenceDocument")

  @@index([assetId])
  @@index([status])
  @@index([categoryCode])
  @@map("documents")
}

/// Version de documento (AC-020 · BR-021). N filas INMUTABLES por documento
/// (append-only: solo created_at, sin updated_at). Editar el contenido crea una
/// NUEVA version (versionNumber = max+1) y conserva la previa. El contenido
/// Markdown va en `content` (@db.Text; tope 200.000 validado en el DTO).
model DocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  versionNumber Int      @map("version_number")
  content       String   @db.Text
  authorUserId  String   @map("author_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  document  Document   @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Restrict)
  author    User       @relation("DocumentVersionAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  currentOf Document[] @relation("DocumentCurrentVersion")

  // Fase 7 (gobierno): registros de validacion que fijan esta version concreta
  // como evidencia inmutable (BR-016, §9).
  validationEvidenceVersions ValidationRecord[] @relation("ValidationEvidenceVersion")

  // Compuesto -> usable como `where` (§1.1); garantiza numeros unicos por documento.
  @@unique([documentId, versionNumber], name: "document_version_number_unique")
  @@index([documentId])
  @@index([authorUserId])
  @@map("document_versions")
}

// ============================================================================
// Fase 7 · Gobierno de la demanda (GateCheck + GatePendingItem + ValidationRecord)
// Diseno aprobado en .agents/tasks/fase7-gobierno/design.md §2.2-2.5.
// ============================================================================

/// Punto de control del ciclo de gobierno (Fase 7 · marco FCGR §5). Una fila por
/// (requestId, gateCode) para los 5 gates. `status` es enum logico GateStatus
/// read-only: solo lo escribe el GovernanceStateService dentro de su $transaction.
model GateCheck {
  id              String    @id @default(uuid()) @db.Uuid
  requestId       String    @map("request_id") @db.Uuid
  gateCode        String    @map("gate_code")
  status          String    @default("PENDIENTE")
  conditionText   String    @map("condition_text")
  authorityText   String    @map("authority_text")
  waiverReason    String?   @map("waiver_reason")
  decidedAt       DateTime? @map("decided_at")
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  request      Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decidedBy    User?              @relation("GateCheckDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  pendingItems GatePendingItem[]
  validations  ValidationRecord[]

  // Compuesto -> usable en findUnique/upsert (Prisma 7, §1.1): materializacion lazy GC1-GC3.
  @@unique([requestId, gateCode], name: "gate_check_request_gate_unique")
  @@index([requestId])
  @@index([status])
  @@map("gate_checks")
}

/// Faltante registrado de un gate no cumplido (marco §5 "Controles pendientes"):
/// que falta, quien lo resuelve y la fecha de revision. Tambien modela el
/// defecto no bloqueante con riesgo aceptado (marco §7, D-C4). Append-only para
/// el alta; se cierra con resolvedAt (soft, sin borrado).
model GatePendingItem {
  id          String    @id @default(uuid()) @db.Uuid
  gateCheckId String    @map("gate_check_id") @db.Uuid
  description String
  ownerUserId String?   @map("owner_user_id") @db.Uuid
  reviewDate  DateTime? @map("review_date") @db.Date
  resolved    Boolean   @default(false)
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  gateCheck GateCheck @relation(fields: [gateCheckId], references: [id], onDelete: Cascade)
  owner     User?     @relation("GatePendingOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([gateCheckId])
  @@index([resolved])
  @@map("gate_pending_items")
}

/// Registro de una prueba/validacion (marco §7). Campos minimos exactos del
/// marco: caso, version, ambiente, ejecutor, fecha, resultado y evidencia.
/// `blocking` marca defecto bloqueante (impide liberar GC4). La evidencia puede
/// fijar una VERSION concreta de Fase 6 via `evidenceDocumentVersionId` (BR-016,
/// evidencia inmutable §9) ademas de apuntar al `Document` padre, o ser texto.
model ValidationRecord {
  id                        String    @id @default(uuid()) @db.Uuid
  requestId                 String    @map("request_id") @db.Uuid
  gateCheckId               String?   @map("gate_check_id") @db.Uuid
  validationTypeCode        String    @map("validation_type_code")
  testCase                  String    @map("test_case")
  version                   String?
  environment               String?
  resultCode                String    @map("result_code")
  blocking                  Boolean   @default(false)
  blockingResolved          Boolean   @default(false) @map("blocking_resolved")
  blockingResolvedAt        DateTime? @map("blocking_resolved_at")
  blockingResolvedByUserId  String?   @map("blocking_resolved_by_user_id") @db.Uuid
  evidenceRef               String?   @map("evidence_ref")
  evidenceDocumentId        String?   @map("evidence_document_id") @db.Uuid
  evidenceDocumentVersionId String?   @map("evidence_document_version_id") @db.Uuid
  executedByUserId          String    @map("executed_by_user_id") @db.Uuid
  executedAt                DateTime  @map("executed_at")
  notes                     String?
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  request                 Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  gateCheck               GateCheck?       @relation(fields: [gateCheckId], references: [id], onDelete: SetNull)
  evidenceDocument        Document?        @relation("ValidationEvidenceDocument", fields: [evidenceDocumentId], references: [id], onDelete: Restrict)
  evidenceDocumentVersion DocumentVersion? @relation("ValidationEvidenceVersion", fields: [evidenceDocumentVersionId], references: [id], onDelete: Restrict)
  executedBy              User             @relation("ValidationExecutor", fields: [executedByUserId], references: [id], onDelete: Restrict)
  blockingResolvedBy      User?            @relation("ValidationBlockingResolver", fields: [blockingResolvedByUserId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([gateCheckId])
  @@index([validationTypeCode])
  @@index([resultCode])
  @@index([blocking])
  @@index([blockingResolved])
  @@map("validation_records")
}
