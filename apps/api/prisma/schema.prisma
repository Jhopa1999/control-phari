// Prisma schema (Prisma ORM v7).
// La URL de conexion NO se define aqui: se configura en prisma.config.ts
// mediante datasource.url = env("DATABASE_URL"), que lee el .env de la raiz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Elemento generico de una maestra/catalogo reutilizable por los portales.
/// No representa ninguna maestra de negocio concreta: `catalog` identifica a
/// que maestra pertenece cada opcion (p. ej. PRIORITY, STATUS, PROJECT_TYPE).
model CatalogItem {
  id        String   @id @default(uuid()) @db.Uuid
  catalog   String
  code      String
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Un codigo es unico dentro de un mismo catalogo, pero puede repetirse en
  // otros catalogos.
  @@unique([catalog, code], name: "catalog_code_unique")
  // Indices para los filtros/orden habituales (catalog, active, sortOrder).
  @@index([catalog])
  @@index([active])
  @@index([sortOrder])
  @@map("catalog_items")
}

/// Proceso de gestion del area (BI, Integraciones, IA) y la coordinacion
/// multiproceso FMAA. `code` es estable y se almacena en MAYUSCULAS.
model Process {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  name      String
  framework String?
  kind      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  grants      Grant[]
  auditEvents AuditEvent[]

  // Fase 2 (flujo de demanda): proceso principal y participaciones.
  requests              Request[]            @relation("RequestMainProcess")
  requestParticipations RequestParticipant[]

  // Fase 3 (plan): tareas que referencian este proceso como contexto (informativo).
  tasks Task[]

  // Fase 4 (capacidad): asignaciones de horas en este proceso.
  assignments Assignment[]

  @@unique([code], name: "process_code_unique")
  @@index([active])
  @@index([sortOrder])
  @@map("processes")
}

/// Identidad funcional de una persona del area. NO es credencial: no hay
/// password, token ni sesion (la autenticacion real es una capa separada).
model User {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  grants      Grant[]
  auditEvents AuditEvent[]

  // Fase 2 (flujo de demanda): actor que registro cada decision.
  triages             Triage[]
  priorityEvaluations PriorityEvaluation[]
  approvals           Approval[]

  // Fase 3 (plan): planes enviados/autorizados y tareas de las que es
  // responsable o que acepto. Cada relacion usa un `name` distinto porque hay
  // mas de una FK User por modelo (Prisma exige nombrarlas).
  plansSubmitted   Plan[] @relation("PlanSubmittedBy")
  plansAuthorized  Plan[] @relation("PlanAuthorizedBy")
  tasksResponsible Task[] @relation("TaskResponsible")
  tasksAccepted    Task[] @relation("TaskAcceptedBy")

  // Fase 4 (capacidad): disponibilidad mensual y asignaciones de la persona.
  monthlyAvailabilities MonthlyAvailability[]
  assignments           Assignment[]          @relation("AssignmentUser")

  @@unique([identifier], name: "user_identifier_unique")
  @@index([active])
  @@map("users")
}

/// Catalogo cerrado de 3 perfiles. El `code` gobierna la logica de
/// autorizacion (enum logico: JEFE_AREA, LIDER_PROCESO, INTEGRANTE).
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  grants Grant[]

  @@unique([code], name: "role_code_unique")
  @@map("roles")
}

/// Asignacion de un usuario a un rol dentro de un proceso. Es el corazon del
/// alcance. Revocar = active=false (soft-delete, por trazabilidad).
model Grant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  processId String   @map("process_id") @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  process Process @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, processId], name: "grant_user_role_process_unique")
  @@index([userId])
  @@index([processId])
  @@index([roleId])
  @@index([active])
  @@map("grants")
}

/// Registro append-only de cada mutacion. Sin updatedAt (es inmutable).
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  objectType     String   @map("object_type")
  objectId       String   @map("object_id")
  scopeProcessId String?  @map("scope_process_id") @db.Uuid
  before         Json?
  after          Json?
  createdAt      DateTime @default(now()) @map("created_at")

  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  scopeProcess Process? @relation(fields: [scopeProcessId], references: [id], onDelete: Restrict)

  @@index([objectType, objectId])
  @@index([actorUserId])
  @@index([scopeProcessId])
  @@index([createdAt])
  @@map("audit_events")
}

// ============================================================================
// Fase 2 · Flujo de demanda (Solicitud -> Triage -> Priorizacion -> Aprobacion)
// Diseno aprobado en .agents/tasks/fase2-demanda/design.md §1.2.
// ============================================================================

/// Solicitud (ficha de la demanda). Nucleo del flujo FLOW-001 (BR-001/017/022).
/// `operationalState` es un enum logico derivado/read-only: solo lo escribe el
/// helper de transicion de RequestStateService, nunca un update/DTO libre.
model Request {
  id                    String    @id @default(uuid()) @db.Uuid
  title                 String
  registeredAt          DateTime  @default(now()) @map("registered_at")
  requesterArea         String?   @map("requester_area")
  requesterName         String?   @map("requester_name")
  functionalOwner       String?   @map("functional_owner")
  targetDate            DateTime? @map("target_date")
  referenceUrl          String?   @map("reference_url")
  expectedResult        String?   @map("expected_result")
  mainProcessId         String    @map("main_process_id") @db.Uuid
  operationalState      String    @default("REGISTRADA") @map("operational_state")
  initialCommitmentDate DateTime? @map("initial_commitment_date")
  changeJustification   String?   @map("change_justification")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  mainProcess         Process              @relation("RequestMainProcess", fields: [mainProcessId], references: [id], onDelete: Restrict)
  participants        RequestParticipant[]
  triages             Triage[]
  priorityEvaluations PriorityEvaluation[]
  approvals           Approval[]

  // Fase 3 (plan): a lo sumo un plan por Request (1:1 efectivo, D1).
  plan Plan?

  // Fase 4 (capacidad): asignaciones opcionalmente ligadas a esta solicitud.
  assignments Assignment[]

  @@index([mainProcessId])
  @@index([operationalState])
  @@index([registeredAt])
  @@map("requests")
}

/// Tabla puente N:M Request <-> Process (procesos participantes). El proceso
/// principal siempre se materializa aqui como invariante de datos (BR-001, D2).
model RequestParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  processId String   @map("process_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  process Process @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@unique([requestId, processId], name: "request_participant_unique")
  @@index([processId])
  @@map("request_participants")
}

/// Triage: clasificacion y decision de ruta (BR-004, SCR-04). Tabla 1:N por
/// extensibilidad futura; en Fase 2 el gate solo admite un Triage por Request.
model Triage {
  id                   String   @id @default(uuid()) @db.Uuid
  requestId            String   @map("request_id") @db.Uuid
  routeCode            String?  @map("route_code")
  demandTypeCode       String?  @map("demand_type_code")
  criticalityCode      String?  @map("criticality_code")
  sizeCode             String?  @map("size_code")
  dataAvailabilityCode String?  @map("data_availability_code")
  totalEffortHours     Int?     @map("total_effort_hours")
  mainResponsible      String?  @map("main_responsible")
  decision             String
  decidedAt            DateTime @default(now()) @map("decided_at")
  decidedByUserId      String   @map("decided_by_user_id") @db.Uuid
  dependencies         String?
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decidedBy User    @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([decidedByUserId])
  @@map("triages")
}

/// Evaluacion ponderada de 8 criterios (BR-005, SCR-05). 1:N historico; la
/// vigente es la ultima por `evaluatedAt`. `score` lo calcula el backend.
model PriorityEvaluation {
  id                String   @id @default(uuid()) @db.Uuid
  requestId         String   @map("request_id") @db.Uuid
  impact            Int
  alignment         Int
  riskControl       Int      @map("risk_control")
  urgency           Int
  scope             Int
  dataAvailability  Int      @map("data_availability")
  feasibility       Int
  reuse             Int
  score             Int
  justification     String?
  evaluatedAt       DateTime @default(now()) @map("evaluated_at")
  evaluatedByUserId String   @map("evaluated_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  request     Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  evaluatedBy User    @relation(fields: [evaluatedByUserId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([evaluatedByUserId])
  @@map("priority_evaluations")
}

/// Decision de autorizacion del compromiso, separada del guardado de la
/// evaluacion (BR-006, SCR-20, D6). Append-only (sin updatedAt).
model Approval {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String   @map("request_id") @db.Uuid
  decision        String
  reason          String?
  previousState   String   @map("previous_state")
  resultingState  String   @map("resulting_state")
  decidedAt       DateTime @default(now()) @map("decided_at")
  decidedByUserId String   @map("decided_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decidedBy User    @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([decidedByUserId])
  @@index([decidedAt])
  @@map("approvals")
}

// ============================================================================
// Fase 3 · Plan y ejecucion (Plan -> Fases -> Tareas -> Dependencias)
// Diseno aprobado en .agents/tasks/fase3-plan/design.md §1.2.
// ============================================================================

/// Plan de trabajo de una Request comprometida (design §1.2, D1). 1:1 efectivo
/// con Request (FK `request_id` unica). `status` es un enum logico PlanStatus
/// read-only: solo lo escribe el helper de PlanStateService, nunca un DTO libre.
/// Nota Prisma 7 (§1.1): el plan se resuelve por `request_id` con `findFirst`,
/// no `findUnique`; el `@@unique` solo garantiza el 1:1 a nivel de BD.
model Plan {
  id                 String    @id @default(uuid()) @db.Uuid
  requestId          String    @map("request_id") @db.Uuid
  periodStart        DateTime? @map("period_start")
  periodEnd          DateTime? @map("period_end")
  commitmentDate     DateTime? @map("commitment_date")
  risks              String?
  mitigations        String?
  status             String    @default("BORRADOR")
  submittedAt        DateTime? @map("submitted_at")
  submittedByUserId  String?   @map("submitted_by_user_id") @db.Uuid
  authorizedAt       DateTime? @map("authorized_at")
  authorizedByUserId String?   @map("authorized_by_user_id") @db.Uuid
  returnReason       String?   @map("return_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  request      Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  phases       PlanPhase[]
  submittedBy  User?       @relation("PlanSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  authorizedBy User?       @relation("PlanAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: Restrict)

  @@unique([requestId], name: "plan_request_unique")
  @@index([status])
  @@map("plans")
}

/// Fase del plan (design §1.2, AC-009). Ordenada por `order` 0-based dentro del
/// plan. La "fase inicial" es la de `order` minimo (propiedad derivada, sin flag).
model PlanPhase {
  id          String    @id @default(uuid()) @db.Uuid
  planId      String    @map("plan_id") @db.Uuid
  name        String
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  deliverable String?
  order       Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  plan  Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([planId, order], name: "plan_phase_order_unique")
  @@index([planId])
  @@map("plan_phases")
}

/// Tarea del plan (design §1.2, BR-009/010/013; AC-010/011/033). `status` y
/// `accepted` son enum logico/derivados: solo los escriben los helpers del
/// modulo plan. El gate de dependientes exige TERMINADA Y accepted.
model Task {
  id                     String    @id @default(uuid()) @db.Uuid
  phaseId                String    @map("phase_id") @db.Uuid
  processId              String?   @map("process_id") @db.Uuid
  title                  String
  responsibleUserId      String?   @map("responsible_user_id") @db.Uuid
  startDate              DateTime? @map("start_date")
  endDate                DateTime? @map("end_date")
  estimateHours          Int?      @map("estimate_hours")
  isMilestone            Boolean   @default(false) @map("is_milestone")
  description            String?
  acceptanceCriteria     String?   @map("acceptance_criteria")
  status                 String    @default("POR_HACER")
  progress               Int       @default(0)
  frameworkPhaseRequired String?   @map("framework_phase_required")
  accepted               Boolean   @default(false)
  acceptedAt             DateTime? @map("accepted_at")
  acceptedByUserId       String?   @map("accepted_by_user_id") @db.Uuid
  evidenceUrl            String?   @map("evidence_url")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  phase       PlanPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  process     Process?  @relation(fields: [processId], references: [id], onDelete: Restrict)
  responsible User?     @relation("TaskResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  acceptedBy  User?     @relation("TaskAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  dependenciesAsDependent   TaskDependency[] @relation("DependencyDependent")
  dependenciesAsPredecessor TaskDependency[] @relation("DependencyPredecessor")

  @@index([phaseId])
  @@index([responsibleUserId])
  @@index([status])
  @@map("tasks")
}

/// Dependencia dirigida entre dos tareas del mismo plan (design §1.2, BR-009;
/// AC-010/033). Append-only (sin updatedAt). El `@@unique` compuesto es la clave
/// de idempotencia/duplicado; se consulta con `findUnique` (compuesto, §1.1).
model TaskDependency {
  id                String   @id @default(uuid()) @db.Uuid
  dependentTaskId   String   @map("dependent_task_id") @db.Uuid
  predecessorTaskId String   @map("predecessor_task_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  dependent   Task @relation("DependencyDependent", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  predecessor Task @relation("DependencyPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, predecessorTaskId], name: "task_dependency_unique")
  @@index([predecessorTaskId])
  @@map("task_dependencies")
}

// ============================================================================
// Fase 4 · Capacidad (Disponibilidad mensual + Asignaciones de horas)
// Diseno aprobado en .agents/tasks/fase4-capacidad/design.md §1.2.
// ============================================================================

/// Disponibilidad de horas de una persona en un mes (BR-012; FLOW-007; SCR-17).
/// Una fila por persona/mes (`@@unique` compuesto). NO se captura por proceso:
/// la disponibilidad es un atributo de la persona en el periodo (D1). `month`
/// se persiste como la fecha del PRIMER dia del mes en UTC (`@db.Date`, D2); el
/// contrato externo usa el string `YYYY-MM` (el service convierte en los DTOs).
model MonthlyAvailability {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  month          DateTime @db.Date
  availableHours Int      @map("available_hours")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Compuesto -> usable como `where` de findUnique/upsert (§1.1, caso favorable).
  @@unique([userId, month], name: "monthly_availability_user_month_unique")
  @@index([month])
  @@map("monthly_availabilities")
}

/// Horas comprometidas de una persona en un mes, en un proceso (requerido) y
/// opcionalmente ligadas a una solicitud (BR-012; SCR-17). Las asignaciones se
/// AGREGAN por periodo/proceso: N filas por persona/mes, SIN `@@unique` estricto
/// (D3). `month` usa el mismo formato (primer dia del mes, UTC) que la
/// disponibilidad. `description` es texto libre informativo (FINDING 7).
model Assignment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  month          DateTime @db.Date
  processId      String   @map("process_id") @db.Uuid
  requestId      String?  @map("request_id") @db.Uuid
  committedHours Int      @map("committed_hours")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user    User     @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  process Process  @relation(fields: [processId], references: [id], onDelete: Restrict)
  request Request? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([userId, month])
  @@index([processId])
  @@index([requestId])
  @@map("assignments")
}
