  "info": {
    "title": "Plantilla Portales API",
    "description": "API estandar para portales internos",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "plantilla-portales-api"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "service",
          "timestamp"
        ]
      },
      "MyGrantDto": {
        "type": "object",
        "properties": {
          "processId": {
            "type": "string",
            "format": "uuid",
            "description": "Id del proceso del grant."
          },
          "processCode": {
            "type": "string",
            "description": "Codigo del proceso.",
            "example": "FIBI"
          },
          "processName": {
            "type": "string",
            "description": "Nombre del proceso.",
            "example": "BI"
          },
          "roleCode": {
            "type": "string",
            "enum": [
              "JEFE_AREA",
              "LIDER_PROCESO",
              "INTEGRANTE"
            ],
            "description": "Rol del grant."
          },
          "roleName": {
            "type": "string",
            "description": "Etiqueta visible del rol.",
            "example": "Lider de proceso"
          }
        },
        "required": [
          "processId",
          "processCode",
          "processName",
          "roleCode",
          "roleName"
        ]
      },
      "MyPermissionsResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Id del usuario actual."
          },
          "name": {
            "type": "string",
            "description": "Nombre del usuario actual.",
            "example": "Ana Jefa"
          },
          "identifier": {
            "type": "string",
            "description": "Identificador funcional.",
            "example": "jefe@demo.local"
          },
          "grants": {
            "description": "Grants activos del usuario.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MyGrantDto"
            }
          },
          "allowedModules": {
            "description": "Claves de modulo permitidas para el/los rol(es) del actor.",
            "example": [
              "permissions",
              "audit",
              "admin"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "userId",
          "name",
          "identifier",
          "grants",
          "allowedModules"
        ]
      },
      "DevActorResponseDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Identificador funcional del usuario.",
            "example": "jefe@demo.local"
          },
          "name": {
            "type": "string",
            "description": "Nombre visible del usuario.",
            "example": "Ana Jefa"
          }
        },
        "required": [
          "identifier",
          "name"
        ]
      },
      "AuditEventResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador del evento."
          },
          "actorUserId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Usuario que origino la mutacion (null si fue el sistema)."
          },
          "action": {
            "type": "string",
            "description": "Verbo de la mutacion.",
            "example": "CREATE"
          },
          "objectType": {
            "type": "string",
            "description": "Tipo de objeto afectado.",
            "example": "GRANT"
          },
          "objectId": {
            "type": "string",
            "description": "Id del objeto afectado."
          },
          "scopeProcessId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Proceso de alcance del evento (null si no aplica)."
          },
          "before": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true,
            "description": "Estado previo (null en CREATE)."
          },
          "after": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true,
            "description": "Estado posterior (null en DELETE fisico)."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Momento del evento."
          }
        },
        "required": [
          "id",
          "actorUserId",
          "action",
          "objectType",
          "objectId",
          "scopeProcessId",
          "before",
          "after",
          "createdAt"
        ]
      },
      "CreateCatalogItemDto": {
        "type": "object",
        "properties": {
          "catalog": {
            "type": "string",
            "description": "Maestra a la que pertenece la opcion (se normaliza a MAYUSCULAS).",
            "example": "PRIORITY",
            "maxLength": 100
          },
          "code": {
            "type": "string",
            "description": "Codigo estable de la opcion dentro del catalogo (se normaliza a MAYUSCULAS).",
            "example": "HIGH",
            "maxLength": 100
          },
          "label": {
            "type": "string",
            "description": "Texto visible al usuario.",
            "example": "Alta",
            "maxLength": 255
          },
          "active": {
            "type": "boolean",
            "description": "Indica si la opcion esta activa. Por defecto true.",
            "default": true,
            "example": true
          },
          "sortOrder": {
            "type": "number",
            "description": "Orden de la opcion dentro del catalogo. Por defecto 0.",
            "default": 0,
            "minimum": 0,
            "example": 1
          }
        },
        "required": [
          "catalog",
          "code",
          "label"
        ]
      },
      "CatalogItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador unico."
          },
          "catalog": {
            "type": "string",
            "description": "Maestra a la que pertenece la opcion.",
            "example": "PRIORITY"
          },
          "code": {
            "type": "string",
            "description": "Codigo estable de la opcion.",
            "example": "HIGH"
          },
          "label": {
