        },
        "summary": "Crea un elemento de catalogo (solo JEFE_AREA).",
        "tags": [
          "catalog-items"
        ]
      },
      "get": {
        "operationId": "CatalogController_findMany",
        "parameters": [
          {
            "name": "active",
            "required": false,
            "in": "query",
            "description": "Filtra por estado activo.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "catalog",
            "required": false,
            "in": "query",
            "description": "Filtra por maestra (se normaliza a MAYUSCULAS).",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de elementos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogItemResponseDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parametros de filtro invalidos."
          }
        },
        "summary": "Lista elementos de catalogo, con filtros opcionales.",
        "tags": [
          "catalog-items"
        ]
      }
    },
    "/catalog-items/{id}": {
      "get": {
        "operationId": "CatalogController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador UUID del elemento.",
            "schema": {
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Elemento encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItemResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "El id no es un UUID valido."
          },
          "404": {
            "description": "Elemento no encontrado."
          }
        },
        "summary": "Obtiene un elemento de catalogo por id.",
        "tags": [
          "catalog-items"
        ]
      },
      "patch": {
        "operationId": "CatalogController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador UUID del elemento.",
            "schema": {
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCatalogItemDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Elemento actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItemResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos de entrada invalidos o id no UUID."
          },
          "403": {
            "description": "Rol insuficiente."
          },
          "404": {
            "description": "Elemento no encontrado."
          }
        },
        "summary": "Actualiza label, active o sortOrder (solo JEFE_AREA).",
        "tags": [
          "catalog-items"
        ]
      }
    },
