# Configuración del servidor MCP (apps/mcp). Copia este archivo a .env local y
# define los valores. El MCP lee SOLO estas variables; no hardcodea nada.
# stdout está reservado al protocolo MCP, así que los errores salen por stderr.

# URL base de la API (apps/api). OBLIGATORIA. Sin credenciales en la URL.
# Si falta, el MCP termina con error entendible a stderr.
MCP_API_BASE_URL=http://localhost:3001

# Transporte del servidor MCP: "stdio" (default, uso local; comportamiento
# histórico sin cambios) o "http" (uso por red). Solo el valor exacto "http"
# selecciona HTTP; cualquier otro valor o su ausencia se trata como stdio.
MCP_TRANSPORT=stdio

# --- Modo http (solo cuando MCP_TRANSPORT=http) ---
# Host y puerto del listener HTTP. Defaults: 0.0.0.0:3002.
# En http la identidad llega POR PETICIÓN en la cabecera
# "Authorization: Bearer <token>" (una persona por token): NO se usan
# MCP_ACTOR_ID / MCP_API_TOKEN / MCP_LOGIN_* (se ignoran en http). Una petición
# sin Bearer válido recibe 401 (nunca un usuario por defecto). El token NUNCA se
# escribe a logs.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3002

# Modo de resolución de identidad. "dev-header" (default) envía X-Actor-Id;
# cualquier valor distinto de "jwt" se trata como dev-header. "jwt" autentica
# con Authorization: Bearer. Debe coincidir con el AUTH_MODE de la API.
MCP_AUTH_MODE=dev-header

# --- Modo dev-header ---
# Identidad que se envía en la cabecera X-Actor-Id. OBLIGATORIA en dev-header.
MCP_ACTOR_ID=jefe@demo.local

# --- Modo jwt: elegir UNA sola vía de credencial ---
# Vía (a): token JWT ya emitido, provisto directamente. NO es recuperable ante
# 401 (sin re-login). Es un secreto: deja el placeholder vacío en el ejemplo.
MCP_API_TOKEN=

# Vía (b): credenciales de login. El MCP hace POST /auth/login de forma
# perezosa y guarda el token SOLO en memoria. Permite re-login reactivo ante
# 401. MCP_LOGIN_PASSWORD es un secreto: deja el placeholder vacío en el ejemplo.
MCP_LOGIN_IDENTIFIER=
MCP_LOGIN_PASSWORD=
