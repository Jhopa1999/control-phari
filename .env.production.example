# Plantilla de variables de PRODUCCION. Copia a .env.production y completa con
# valores reales. NO versionar .env.production (contiene secretos).

# --- PostgreSQL ---
POSTGRES_DB=plantilla_portales
POSTGRES_USER=portal_user
# Usa un secreto fuerte y unico. NO uses este valor de ejemplo en produccion.
POSTGRES_PASSWORD=cambia_este_secreto

# DATABASE_URL la construye compose.prod.yaml a partir de las variables de arriba
# apuntando al servicio "postgres" (postgresql://user:pass@postgres:5432/db).
# No es necesario definirla aqui salvo que quieras sobreescribirla.

# --- Frontend (publico) ---
# En produccion el navegador consume la API por el mismo dominio via Nginx.
NEXT_PUBLIC_API_BASE_URL=/api

# --- CORS ---
# Con Nginx y mismo dominio (/api), normalmente NO hace falta CORS porque no hay
# cross-origin. Dejalo vacio para no habilitar CORS. Si sirves el frontend desde
# otro origen, lista aqui los origenes permitidos separados por comas.
CORS_ORIGINS=

# --- Nginx ---
# Puerto publico del host (80 por defecto; 443 cuando configures HTTPS).
HTTP_PORT=80

# --- Autenticacion ---
# AUTH_MODE controla el mecanismo de identidad del backend. El valor
# "dev-header" (usado en desarrollo) habilita el selector de usuario y la ruta
# publica GET /dev/actors, y confia en la cabecera X-Actor-Id SIN verificacion:
# es SOLO para desarrollo local. NO lo definas como "dev-header" en produccion.
# En produccion usa autenticacion real por JWT: AUTH_MODE=jwt. En ese modo
# POST /auth/login emite un token y las peticiones protegidas viajan con
# "Authorization: Bearer <token>"; /dev/actors responde 404 (no se expone el
# selector dev). NO uses "dev-header" en produccion.
AUTH_MODE=jwt

# Secreto para firmar/verificar los JWT. OBLIGATORIO con AUTH_MODE=jwt (si falta,
# la app no arranca). Usa un secreto fuerte y unico; NO versiones el valor real:
# deja el placeholder vacio aqui y define el secreto en .env.production.
JWT_SECRET=

# Vigencia del token (formato de @nestjs/jwt, p. ej. "8h"). Por defecto 8h.
JWT_EXPIRES_IN=8h

# --- Correo (SMTP) ---
# Servidor SMTP para notificaciones (reestablecimiento de contrasena,
# invitaciones). Office365 usa smtp.office365.com:587 con STARTTLS
# (SMTP_SECURE=false; usa true solo para SSL directo en el puerto 465).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
# Credenciales SMTP: SECRETOS por-ambiente. Deja el placeholder vacio aqui y
# define el valor real en .env.production (que NO se versiona).
SMTP_USER=
SMTP_PASSWORD=
# Direccion remitente de los correos. Por-ambiente: dejar vacio en el repo.
MAIL_FROM=
# Nombre visible opcional del remitente. No es secreto.
MAIL_FROM_NAME=Notificaciones
# URL base del frontend para construir enlaces (reset, invitacion). Ajustar al
# dominio publico de produccion.
APP_WEB_URL=https://portal.example.com

# Vigencia del enlace de reestablecimiento de contrasena. Formato simple
# <numero><unidad> (s/m/h/d) o milisegundos; por defecto 1h. No es secreto.
PASSWORD_RESET_TTL=1h
# Vigencia del enlace de invitacion/activacion de cuenta. Por defecto 72h.
USER_INVITATION_TTL=72h
# Longitud minima de contrasena al reestablecer/activar. Por defecto 8.
PASSWORD_MIN_LENGTH=8

# --- Observabilidad / Logging ---
# Nivel de log del backend (pino). Valores validos:
# fatal | error | warn | info | debug | trace | silent. Por defecto "info" si
# no se define. No es un secreto; es configuracion por ambiente.
LOG_LEVEL=info
# En produccion NO definas LOG_PRETTY (o dejalo distinto de "true"): el backend
# emite JSON estructurado, apto para agregadores de logs. El formato legible
# (pino-pretty) es solo para desarrollo. No es un secreto.

# --- Cifrado de secretos de configuracion ---
# Clave para cifrar/descifrar secretos de configuracion guardados en BD (hoy: el
# password SMTP editable desde administracion). 32 bytes codificados en base64.
# Genera uno con: openssl rand -base64 32
# Es un SECRETO por-ambiente: deja el placeholder vacio en el repo y define el
# valor real en tu .env local/produccion. Obligatoria SOLO al leer/escribir el
# password SMTP; el API arranca sin ella. Si la pierdes/rotas, el password
# cifrado guardado deja de poder descifrarse y hay que reconfigurarlo.
SETTINGS_ENCRYPTION_KEY=
