# Plantilla de variables de PRODUCCION. Copia a .env.production y completa con
# valores reales. NO versionar .env.production (contiene secretos).

# --- PostgreSQL ---
POSTGRES_DB=plantilla_portales
POSTGRES_USER=portal_user
# Usa un secreto fuerte y unico. NO uses este valor de ejemplo en produccion.
POSTGRES_PASSWORD=cambia_este_secreto

# DATABASE_URL la construye compose.prod.yaml a partir de las variables de arriba
# apuntando al servicio "postgres" (postgresql://user:pass@postgres:5432/db).
# No es necesario definirla aqui salvo que quieras sobreescribirla.

# --- Frontend (publico) ---
# En produccion el navegador consume la API por el mismo dominio via Nginx.
NEXT_PUBLIC_API_BASE_URL=/api

# --- CORS ---
# Con Nginx y mismo dominio (/api), normalmente NO hace falta CORS porque no hay
# cross-origin. Dejalo vacio para no habilitar CORS. Si sirves el frontend desde
# otro origen, lista aqui los origenes permitidos separados por comas.
CORS_ORIGINS=

# --- Nginx ---
# Puerto publico del host (80 por defecto; 443 cuando configures HTTPS).
HTTP_PORT=80

# --- Autenticacion ---
# AUTH_MODE controla el mecanismo de identidad del backend. El valor
# "dev-header" (usado en desarrollo) habilita el selector de usuario y la ruta
# publica GET /dev/actors, y confia en la cabecera X-Actor-Id SIN verificacion:
# es SOLO para desarrollo local. NO lo definas como "dev-header" en produccion.
# En produccion usa autenticacion real por JWT: AUTH_MODE=jwt. En ese modo
# POST /auth/login emite un token y las peticiones protegidas viajan con
# "Authorization: Bearer <token>"; /dev/actors responde 404 (no se expone el
# selector dev). NO uses "dev-header" en produccion.
AUTH_MODE=jwt

# Secreto para firmar/verificar los JWT. OBLIGATORIO con AUTH_MODE=jwt (si falta,
# la app no arranca). Usa un secreto fuerte y unico; NO versiones el valor real:
# deja el placeholder vacio aqui y define el secreto en .env.production.
JWT_SECRET=

# Vigencia del token (formato de @nestjs/jwt, p. ej. "8h"). Por defecto 8h.
JWT_EXPIRES_IN=8h
