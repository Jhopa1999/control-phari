# Plantilla de variables de PRODUCCION. Copia a .env.production y completa con
# valores reales. NO versionar .env.production (contiene secretos).

# --- PostgreSQL ---
POSTGRES_DB=plantilla_portales
POSTGRES_USER=portal_user
# Usa un secreto fuerte y unico. NO uses este valor de ejemplo en produccion.
POSTGRES_PASSWORD=cambia_este_secreto

# DATABASE_URL la construye compose.prod.yaml a partir de las variables de arriba
# apuntando al servicio "postgres" (postgresql://user:pass@postgres:5432/db).
# No es necesario definirla aqui salvo que quieras sobreescribirla.

# --- Frontend (publico) ---
# En produccion el navegador consume la API por el mismo dominio via Nginx.
NEXT_PUBLIC_API_BASE_URL=/api

# --- CORS ---
# Con Nginx y mismo dominio (/api), normalmente NO hace falta CORS porque no hay
# cross-origin. Dejalo vacio para no habilitar CORS. Si sirves el frontend desde
# otro origen, lista aqui los origenes permitidos separados por comas.
CORS_ORIGINS=

# --- Nginx ---
# Puerto publico del host (80 por defecto; 443 cuando configures HTTPS).
HTTP_PORT=80
