# Configuracion del respaldo de la base de datos (BL-004).
# Se instala en el servidor como /etc/control-phari-backup.env (permisos 600).
# NO contiene secretos: la subida a S3 usa el rol IAM de la instancia.

# Bucket de respaldos (obligatorio). Privado, cifrado y con regla de ciclo de vida.
S3_BUCKET=control-phari-backups-CUENTA

# Opcionales (valores por defecto entre parentesis):
# S3_PREFIX=postgres                          (postgres)
# AWS_REGION=us-east-2                        (us-east-2)
# PG_CONTAINER=control-phari-postgres-1       (control-phari-postgres-1)
# BACKUP_DIR=/var/backups/control-phari       (/var/backups/control-phari)
# LOCAL_RETENTION_DAYS=7                      (7)
# AWSCLI_IMAGE=amazon/aws-cli:2.17.0          (amazon/aws-cli:2.17.0)
